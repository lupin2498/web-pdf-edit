# Cấu hình máy chủ PDF Edit Online.
# Sao chép thành ".env" (cùng thư mục) rồi sửa giá trị. Biến môi trường của hệ
# thống (Docker, systemd...) được ưu tiên hơn tệp .env.

# ----------------------------------------------------------------- chung
PORT=3000
# HOST=0.0.0.0
# Địa chỉ công khai của trang (bắt buộc khi chạy thật: dùng cho liên kết chuẩn,
# sitemap, PayPal). Chỉ gồm giao thức + tên miền.
SITE_URL=https://pdf.example.com
SITE_NAME=PDF Edit
# Email hiển thị ở chân trang, chính sách bảo mật và khi chưa có phương thức thanh toán.
CONTACT_EMAIL=hotro@example.com
# Thư mục chứa cơ sở dữ liệu SQLite (data/pdfedit.sqlite). Nhớ sao lưu thư mục này.
DATA_DIR=data
# Chuỗi bí mật ký cookie phiên. Để trống: tự tạo và lưu trong cơ sở dữ liệu.
# SESSION_SECRET=
# Máy chủ đứng sau reverse proxy (nginx, Caddy...):
#   0 = không có proxy, 1 = một proxy (đặt X-Forwarded-For), 2 = hai proxy,
#   cloudflare = dùng địa chỉ trong CF-Connecting-IP.
TRUST_PROXY=0
# Ghi nhật ký mọi yêu cầu HTTP.
# LOG_REQUESTS=0

# ----------------------------------------------------------------- trang miễn phí
# Số trang miễn phí của mỗi người dùng (mỗi trang tải xuống, in, chuyển đổi = 1 trang).
FREE_PAGES=5
# 0 = trang miễn phí không hồi lại; N = cấp lại sau mỗi N ngày.
FREE_RESET_DAYS=0
# Giới hạn tổng số trang miễn phí cấp cho một địa chỉ IP mỗi ngày (chống xóa cookie
# để dùng tiếp). Mạng di động dùng chung một IP cho nhiều người, nên đừng đặt quá thấp.
# Mặc định: FREE_PAGES x 20. 0 = không giới hạn.
# FREE_IP_DAILY_PAGES=100

# ----------------------------------------------------------------- gói trang
# Danh sách gói (JSON). vnd: giá chuyển khoản (đồng), usd: giá PayPal (đô la).
# PACKS=[{"id":"p20","pages":20,"vnd":10000,"usd":1.49},{"id":"p100","pages":100,"vnd":39000,"usd":3.99,"popular":true},{"id":"p500","pages":500,"vnd":149000,"usd":11.99}]
# Thời gian giữ đơn chờ thanh toán (phút).
ORDER_TTL_MINUTES=60

# ----------------------------------------------------------------- chuyển khoản VietQR
# Ngân hàng nhận tiền: mã viết tắt (VCB, ICB, BIDV, VBA, MB, TCB, ACB, VPB, TPB,
# STB, HDB, VIB, SHB, ...) hoặc mã BIN 6 số (BANK_BIN).
BANK_CODE=MB
# Số tài khoản (tối đa 19 ký tự) và tên chủ tài khoản (không dấu).
BANK_ACCOUNT=0123456789
BANK_ACCOUNT_NAME=NGUYEN VAN A
# Tiền tố mã đơn trong nội dung chuyển khoản (2-6 chữ cái).
ORDER_PREFIX=PE
# Xác nhận tự động qua SePay (sepay.vn): tạo webhook trỏ tới
#   https://<tên miền>/api/pay/sepay/webhook
# với kiểu xác thực "API Key" và dán khóa đó vào đây.
SEPAY_API_KEY=
# Hoặc xác thực bằng chữ ký HMAC-SHA256 (X-SePay-Signature / X-SePay-Timestamp).
# SEPAY_WEBHOOK_SECRET=
# Không dùng SePay: xác nhận đơn thủ công trong trang /admin khi nhận được tiền.

# ----------------------------------------------------------------- PayPal
# Tạo ứng dụng REST tại developer.paypal.com, lấy Client ID và Secret.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# live (mặc định) hoặc sandbox để thử nghiệm.
PAYPAL_ENV=live

# ----------------------------------------------------------------- quảng cáo
# Google AdSense: mã nhà xuất bản và mã đơn vị quảng cáo cho từng vị trí.
# ads.txt được tạo tự động từ ADSENSE_CLIENT.
ADSENSE_CLIENT=
# ADSENSE_SLOT_LANDING_TOP=1234567890
# ADSENSE_SLOT_LANDING_MID=1234567890
# ADSENSE_SLOT_LANDING_BOTTOM=1234567890
# ADSENSE_SLOT_APP_HOME=1234567890
# ADSENSE_SLOT_APP_SIDE=1234567890
# Mạng quảng cáo khác: mã HTML cho từng vị trí và mã đặt trong <head>.
# ADS_HTML_LANDING_TOP=<div>...</div>
# ADS_CUSTOM_HEAD=<script async src="..."></script>
# Dòng bổ sung cho ads.txt (phân tách bằng ;).
# ADS_TXT=
# Quảng cáo nội bộ (giới thiệu gói trang) khi vị trí chưa có quảng cáo mạng.
ADS_HOUSE=1
# Ẩn quảng cáo với người dùng còn trang đã mua.
ADS_HIDE_FOR_PAID=1
# Google Analytics 4 (tùy chọn).
# GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ----------------------------------------------------------------- quản trị
# Mật khẩu trang /admin (ít nhất 12 ký tự). Để trống = tắt trang quản trị.
ADMIN_TOKEN=

# ----------------------------------------------------------------- chỉ để thử nghiệm
# Cho phép hoàn tất đơn mà không trả tiền. KHÔNG bật khi chạy thật.
# PAYMENTS_TEST_MODE=0
