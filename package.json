{
  "name": "web-pdf-edit",
  "version": "1.0.0",
  "description": "PDF Edit Online - trình chỉnh sửa PDF trên trình duyệt (sửa nội dung, chú thích, sắp xếp trang, gộp/tách, chuyển đổi) kèm quảng cáo và mua lượt sử dụng",
  "author": "lupin2498",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "start": "node server/index.mjs",
    "dev": "node scripts/build.mjs --dev && node server/index.mjs",
    "test": "npm run test:unit && npm run test:server",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:server": "node --test --test-concurrency=1 \"tests/server/**/*.test.mjs\"",
    "test:e2e": "npm run build && node --test --test-concurrency=1 \"tests/e2e/**/*.test.mjs\"",
    "test:all": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@cantoo/fontkit": "2.0.12",
    "@cantoo/pdf-lib": "2.11.1",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "pdfjs-dist": "6.4.299",
    "playwright-core": "1.63.0",
    "qrcode-generator": "^2.0.4"
  }
}
